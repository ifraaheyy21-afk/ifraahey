# Copy to .env.local for development, and set the same names in your host
# (for example Vercel > Project > Settings > Environment Variables).
# The server checks these at startup (src/lib/env.ts).

# --- Required -------------------------------------------------------------

# Postgres (Supabase pooler URL is fine)
DATABASE_URL=

# Firebase Admin, used to verify sign-ins
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 64 hex characters: openssl rand -hex 32
# Encrypts Resend keys and OAuth tokens. Changing it makes stored credentials unreadable.
INTEGRATION_ENCRYPTION_KEY=

# At least 16 characters. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Public https origin of the app, no trailing slash. Used in email links and webhooks.
APP_URL=
NEXT_PUBLIC_APP_URL=

# --- Recommended ----------------------------------------------------------

# Signs unsubscribe links. Falls back to CRON_SECRET when unset.
UNSUBSCRIBE_SECRET=

# AI features (generation, insights, AI workflow builder)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_SUMMARY_MODEL=
AUTOMATION_BUILDER_MODEL=

# Per-workspace AI request limits (defaults 20 per minute, 500 per day)
AI_RATE_LIMIT_PER_MINUTE=
AI_RATE_LIMIT_PER_DAY=

# Optional separate secret for non-Vercel schedulers calling the automation worker
AUTOMATION_WORKER_SECRET=

# Email sample image uploads
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Integrations (each is optional) --------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=
SALESFORCE_LOGIN_URL=

PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_REDIRECT_URI=
PIPEDRIVE_OAUTH_URL=

INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=
INTERCOM_REDIRECT_URI=

ZAPIER_OAUTH_CLIENT_ID=
ZAPIER_OAUTH_CLIENT_SECRET=
ZAPIER_OAUTH_REDIRECT_URI=

# --- Local development only -----------------------------------------------

# Workspace to use when the database is unreachable (ignored in production)
DEV_WORKSPACE_ID=
