generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id              String                 @id @default(cuid())
  name            String?
  userEmail       String?                @unique
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  brandProfiles   BrandEmailProfile[]
  customers       Customer[]
  emailEvents     EmailEvent[]
  masterTemplates EmailMasterTemplate[]
  emailSamples    EmailSample[]
  generatedEmails GeneratedEmail[]
  scheduledEmails ScheduledEmail[]
  suppressions    Suppression[]
  trackedLinks    TrackedLink[]
  integrations    WorkspaceIntegration[]
}

model BrandEmailProfile {
  id                    String    @id @default(cuid())
  workspaceId           String
  companyName           String?
  website               String?
  companyDescription    String?
  idealCustomer         String?
  guidelines            Json?
  logoStyle             String?
  primaryColor          String?
  secondaryColor        String?
  backgroundColor       String?
  fontFamily            String?
  layoutStyle           String?
  buttonStyle           Json?
  emojiStyle            String?
  iconStyle             String?
  headerStyle           String?
  footerStyle           String?
  tone                  String?
  spacing               String?
  contentPattern        String?
  ctaPattern            String?
  recommendedEmailTypes Json?
  rawProfile            Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model EmailSample {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  imageUrl    String
  fileName    String?
  mimeType    String?
  sizeBytes   Int?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model GeneratedEmail {
  id              String           @id @default(cuid())
  workspaceId     String
  emailType       String
  subject         String
  html            String
  plainText       String?
  status          String           @default("draft")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  emailEvents     EmailEvent[]
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scheduledEmails ScheduledEmail[]

  @@index([workspaceId])
  @@index([status])
}

model Customer {
  id              String           @id @default(cuid())
  workspaceId     String
  name            String
  email           String
  company         String
  emailsSent      Int              @default(0)
  openRate        Float            @default(0)
  clickRate       Float            @default(0)
  status          String           @default("Active")
  lastEmail       String           @default("Never")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  unsubscribedAt  DateTime?
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailEvents     EmailEvent[]
  scheduledEmails ScheduledEmail[]

  @@index([workspaceId])
  @@index([email])
}

model Suppression {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  reason      String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([email])
}

model ScheduledEmail {
  id                String          @id @default(cuid())
  workspaceId       String
  customerId        String
  generatedEmailId  String?
  emailType         String
  subject           String
  html              String
  plainText         String?
  scheduledFor      DateTime
  sentAt            DateTime?
  status            String          @default("scheduled")
  failureReason     String?
  providerMessageId String?
  retryCount        Int             @default(0)
  lastRetryAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  deliveredAt       DateTime?
  bouncedAt         DateTime?
  complainedAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  emailEvents       EmailEvent[]
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  generatedEmail    GeneratedEmail? @relation(fields: [generatedEmailId], references: [id])
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([customerId])
  @@index([generatedEmailId])
  @@index([status])
  @@index([scheduledFor])
}

model EmailEvent {
  id                String          @id @default(cuid())
  workspaceId       String
  customerId        String
  generatedEmailId  String?
  scheduledEmailId  String?
  emailType         String
  subject           String
  status            String
  reason            String?
  providerMessageId String?
  createdAt         DateTime        @default(now())
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  generatedEmail    GeneratedEmail? @relation(fields: [generatedEmailId], references: [id])
  scheduledEmail    ScheduledEmail? @relation(fields: [scheduledEmailId], references: [id])
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([customerId])
  @@index([generatedEmailId])
  @@index([scheduledEmailId])
  @@index([status])
  @@index([createdAt])
}

model EmailMasterTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  sampleId    String?
  title       String
  html        String
  subject     String
  heading     String
  body        String
  ctaText     String
  ctaLink     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sampleId])
}

model TrackedLink {
  id               String    @id @default(cuid())
  workspaceId      String
  scheduledEmailId String
  customerId       String
  originalUrl      String
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([scheduledEmailId])
  @@index([customerId])
}

model WorkspaceIntegration {
  id               String              @id @default(cuid())
  workspaceId      String
  provider         IntegrationProvider
  status           IntegrationStatus   @default(connected)
  accessToken      String
  refreshToken     String?
  instanceUrl      String?
  tokenType        String?
  scope            String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  externalUserId   String?
  externalOrgId    String?
  lastSyncedAt     DateTime?
  syncStatus       String?
  syncError        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  webhookChannel   String?
  webhookChannelId String?
  webhookUrl       String?
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@index([provider])
}

enum IntegrationProvider {
  salesforce
  hubspot
  stripe
  pipedrive
  resend
  sendgrid
  mailgun
  posthog
  intercom
  slack
  google_calendar
  zapier
}

enum IntegrationStatus {
  connected
  disconnected
  expired
  error
}
